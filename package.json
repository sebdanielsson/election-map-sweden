{
  "name": "election-map-swe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f .env.development -- next dev --turbopack",
    "build": "dotenvx run -f .env.production -- next build",
    "start": "dotenvx run -f .env.production -- next start",
    "lint": "oxlint --type-aware .",
    "dotenvx": "dotenvx",
    "download-districts": "pnpm run scripts/downloadDistricts.ts temp/districts/EPSG3006",
    "transform-geojson": "pnpm run scripts/transformGeojson.ts temp/districts/EPSG3006 public/data/districts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "stylelint": "stylelint --allow-empty-input \"app/**/*.css\""
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.0.0",
    "@types/unzipper": "^0.10.11",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "mapbox-gl": "^3.18.1",
    "next": "16.3.0",
    "proj4": "^2.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/webpack": "^4.2.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/webpack-env": "^1.18.8",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.6",
    "stylelint": "^17.3.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~7.0.2",
    "unzipper": "^0.12.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "packageManager": "pnpm@11.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.19.0 <12.0.0",
      "onFail": "download"
    }
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ]
}
