{
  "name": "election-map-swe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f .env.development -- vite",
    "build": "dotenvx run -f .env.production -- vite build",
    "preview": "dotenvx run -f .env.production -- vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "dotenvx": "dotenvx",
    "download-districts": "node --experimental-strip-types scripts/downloadDistricts.ts",
    "transform-geojson": "node --experimental-strip-types scripts/transformGeojson.ts",
    "trim-results": "node --experimental-strip-types scripts/trimResults.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vercel/speed-insights": "^2.0.0",
    "mapbox-gl": "^3.29.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "oxc-transform-react": "^0.151.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "proj4": "^2.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "unzipper": "^0.12.5",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  }
}
