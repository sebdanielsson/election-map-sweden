{
  "name": "election-map-swe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f .env.development -- vite",
    "build": "dotenvx run -f .env.production -- vite build",
    "preview": "dotenvx run -f .env.production -- vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "dotenvx": "dotenvx",
    "download-districts": "node --experimental-strip-types scripts/downloadDistricts.ts",
    "transform-geojson": "node --experimental-strip-types scripts/transformGeojson.ts",
    "trim-results": "node --experimental-strip-types scripts/trimResults.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "mapbox-gl": "^3.34.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.3.0",
    "axios": "^1.21.1",
    "oxc-transform-react": "^0.158.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "proj4": "^2.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "unzipper": "^0.12.5",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
}
