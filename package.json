{
  "name": "election-map-swe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f .env.development -- vite",
    "build": "dotenvx run -f .env.production -- vite build",
    "preview": "dotenvx run -f .env.production -- vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dotenvx": "dotenvx",
    "download-districts": "node --experimental-strip-types scripts/downloadDistricts.ts temp/districts/EPSG3006",
    "transform-geojson": "node --experimental-strip-types scripts/transformGeojson.ts temp/districts/EPSG3006 public/data/districts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@vercel/speed-insights": "^2.0.0",
    "mapbox-gl": "^3.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.1.0",
    "axios": "^1.13.5",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "proj4": "^2.20.2",
    "tailwindcss": "^4.2.1",
    "typescript": "~7.0.2",
    "unzipper": "^0.12.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
