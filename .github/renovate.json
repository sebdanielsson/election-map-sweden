{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>sebdanielsson/renovate-config"],
  "packageRules": [
    {
      "groupName": "all patch dependencies (manual)",
      "groupSlug": "all-patch-manual",
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["*"]
    },
    {
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "matchPackageNames": ["!typescript"]
    },
    {
      "groupName": "oxc",
      "matchPackageNames": [
        "oxlint",
        "oxlint-**",
        "@oxlint/**",
        "oxfmt",
        "@oxfmt/**",
        "eslint-plugin-oxlint",
        "oxc-**",
        "@oxc-*/**"
      ]
    },
    {
      "description": "The shared preset automerges stable minor and patch updates. TypeScript doesn't follow semver and its minor releases can break type checking, so review those by hand.",
      "matchPackageNames": ["typescript"],
      "automerge": false
    }
  ]
}
